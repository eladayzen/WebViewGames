# Dependencies & build output (per-project, applies to every game folder in this repo)
node_modules/
dist/
dist-ssr/
*.local

# Zip exports/backups — redundant with already-tracked source, not meant for git
*.zip

# Raw gameplay-reference material dropped for the pipeline's video-analyst
# stage — throwaway input (already distilled into pipeline/reports/*.md),
# never meant for git history. Whole folder, not just video extensions
# (some videos run into the hundreds of MB, which GitHub hard-rejects
# outright above 100MB per file) -- notes/README files dropped in here are
# working scratch too, not meant to be tracked.
pipeline/videos-inbox/

# Concept-frame images generated for macro briefs — large (several MB each,
# ~80MB across the briefs so far) and fully regenerable: each concepts/
# folder keeps its prompt.txt, which is the actual recipe. The brief.md and
# prompt.txt stay tracked; only the rendered output is ignored.
pipeline/macro-briefs/**/concepts/*.png
pipeline/macro-briefs/**/concepts/*.jpg
pipeline/macro-briefs/**/concepts/*.jpeg
pipeline/macro-briefs/**/concepts/*.webp

# Mixamo rigging staging assets — the T-posed mesh uploaded to Mixamo's
# auto-rigger plus its source renders (~23MB). One-shot inputs: the rigged
# output that the game actually loads lives in src/assets/rig/, and each
# folder's README.md records the exact recipe (gpt-image-2 strict-T-pose
# render -> meshy/v6-preview/image-to-3d), so these are reproducible rather
# than precious. The README itself stays tracked.
*/art/mixamo-upload/*
!*/art/mixamo-upload/README.md

# Agent worktrees. `.claude/worktrees/<name>` is a live git worktree -- a full
# second checkout of this repo (370MB at the time of writing). Committing it
# would nest the repo inside itself; it is scratch belonging to whichever
# session is using it, and `git worktree` already tracks it properly elsewhere.
.claude/worktrees/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
